GOOGLE_CLIENT_ID=ваш-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ваш-client-secret

# Куда Google возвращает браузер после согласия — ЧЕРЕЗ ГЕЙТВЕЙ (не напрямую
# на этот сервис!), чтобы success-страница получила origin гейтвея, а не
# :8080 — тогда её relative-ссылки/fetch (href="/", /api/wallets и т.п.)
# сами попадают на wallet-bff/wallet-api через тот же гейтвей, без ручного
# "откройте адрес гейтвея" (см. README wallet-bff, "Как это работает через
# гейтвей"). Значение должно ТОЧНО совпадать с Authorized redirect URI в
# Google Cloud Console — см. README, шаг 1. При смене порта гейтвея
# (PORT в wallet-gateway/.env) поменяйте оба места синхронно.
REDIRECT_URL=http://localhost:8090/auth/google/callback

# Доп. redirect_uri через запятую — выбираются динамически по Host/
# X-Forwarded-Host входящего запроса (см. google.cpp::resolve_redirect_uri),
# когда нужно логиниться И с этой машины (localhost), И с устройств в LAN
# ОДНОВРЕМЕННО одним и тем же сервисом (без этого — только одно из двух,
# см. чат/README про self-hairpin на собственный LAN IP). Каждое значение
# здесь ОБЯЗАНО быть точь-в-точь и в Authorized redirect URIs того же Client
# ID в Google Console (Console разрешает несколько записей на одном клиенте)
# — иначе Google просто отклонит обмен. Raw IP Google не принимает вообще
# ("must use a domain that is a valid top private domain") — для LAN-адреса
# см. обходной путь через nip.io/sslip.io (wildcard DNS вида
# "<ваш-LAN-IP>.nip.io" резолвится ровно в этот IP, но выглядит для Google
# как обычный домен с валидным TLD).
#
# Для подсети 192.168.* набирать сам nip.io-адрес в браузере не обязательно
# — resolve_redirect_uri сам переписывает голый Host "192.168.x.x[:порт]" в
# "192.168.x.x.nip.io[:порт]" ПЕРЕД сверкой с этим списком (см. README, "Вход
# и с localhost, и по LAN одновременно"); nip.io-значение здесь и в Google
# Console всё равно обязательно.
# ALLOWED_REDIRECT_URIS=http://192.168.1.105.nip.io:8090/auth/google/callback

# Postgres для users (см. db.cpp/repo.cpp) — база и роль должны уже
# существовать, схему накатывает отдельная роль-мигратор (infra/db/init-db.sh в
# корне репозитория), не этот сервис — см. его README, "Персистентность".
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis — хранит активные access- И refresh-токены (ключи
# "access_token:<sha256(токена)>"/"refresh_token:<sha256(токена)>", TTL =
# ACCESS_TOKEN_TTL_SECS/REFRESH_TOKEN_TTL_SECS соответственно, см. repo.hpp).
# Даёт /auth/logout возможность отозвать access-токен мгновенно, но ТОЛЬКО
# для проверок внутри этого сервиса (auth::authenticate()) — wallet-api/
# wallet-gateway проверяют токен по JWKS локально и про такой отзыв не
# узнают (см. README, "Мгновенный logout — только в auth-сервисе"). Свой
# клиент поверх RESP, без внешней библиотеки — см. src/redis_client.hpp.
# В контейнерном сценарии (compose.yaml) Redis поднят с AOF-персистентностью
# и volume — без этого пересоздание контейнера стирало бы 30-дневные
# refresh-токены всех пользователей разом (см. README, "Персистентность").
REDIS_HOST=localhost
REDIS_PORT=6379
# Пусто, если Redis без пароля (requirepass не задан) — обычная ситуация для
# локальной разработки и для контейнера в приватной docker-сети.
# REDIS_PASSWORD=

# Приватный RSA-ключ (PEM) для подписи СВОИХ access-токенов (RS256, не
# Google!). Публичная часть отдаётся всем желающим на
# GET /.well-known/jwks.json — никакого общего секрета с другими сервисами
# (wallet-bff, wallet-gateway) заводить не нужно, они сами её оттуда
# заберут. Сгенерировать:
#   openssl genrsa -out jwt_signing_key.pem 2048
# Держите вне git (см. .gitignore) — компрометация даёт возможность
# подписывать токены от имени любого пользователя.
JWT_RSA_PRIVATE_KEY_PATH=jwt_signing_key.pem

# true только за HTTPS в проде; для http://localhost оставьте false —
# иначе браузер не примет cookie с флагом Secure по обычному http.
COOKIE_SECURE=false

# TTL access-токена (JWT) и refresh-токена, в секундах. Access — короткий
# специально: по истечении клиент идёт в POST /auth/refresh за новым, а не
# логинится через Google заново (это и делает refresh-токен). Значения ниже
# — дефолты, раскомментируйте только чтобы их поменять.
# ACCESS_TOKEN_TTL_SECS=900
# REFRESH_TOKEN_TTL_SECS=2592000

# Роли (см. README → "Роль администратора"). Список email через запятую,
# регистр не важен. Требуется email_verified от Google. Пусто по умолчанию —
# все обычные пользователи (role=user, видят только свои кошельки).
#   admin   — видит и правит (включая удаление) кошельки ВСЕХ пользователей.
#   support — видит кошельки ВСЕХ пользователей, но НЕ может их менять/удалять
#             (только чтение — типичный доступ для диагностики).
# Если email есть в обоих списках — побеждает admin.
# ADMIN_EMAILS=you@gmail.com, colleague@gmail.com
# SUPPORT_EMAILS=support@gmail.com

# Telegram-бот wallet-telegram (src/telegram.cpp, org/docs/TODO_telegram_bot.md).
# Оба необязательны: без них POST /auth/telegram/link-code и
# POST /internal/telegram/exchange отвечают 503, остальное работает как раньше.
# TELEGRAM_BOT_USERNAME — username бота без '@' (для deep link t.me/<bot>?start=...).
# TELEGRAM_SERVICE_SECRET — общий секрет с wallet-telegram (заголовок
# X-Service-Secret), одинаковый в .env обоих сервисов; сгенерировать:
#   openssl rand -base64 32
# TELEGRAM_BOT_USERNAME=WalletTransaction_bot
# TELEGRAM_SERVICE_SECRET=
# TELEGRAM_LINK_CODE_TTL_SECS=600

# Обмен токена POST /internal/token/exchange (src/token_exchange.cpp, README
# «Обмен токена»): секреты сервисов-actor'ов, "имя=секрет" через запятую. У
# каждого сервиса свой, тот же — в AUTH_EXCHANGE_SECRET его .env. Допустимые
# имена — wallet-ai и wallet-mcp. Пусто — обмен выключен (503); ошибка формата
# — сервис не стартует. Сгенерировать: openssl rand -base64 32
# TOKEN_EXCHANGE_SECRETS=wallet-ai=<секрет>,wallet-mcp=<секрет>

PORT=8080
# 127.0.0.1 — только локально (Windows-разработка). На Linux-сервере,
# слушающем внешние подключения, поставьте HOST=0.0.0.0.
HOST=127.0.0.1

# Обычно не нужно: cpp-httplib сам использует системное хранилище
# сертификатов (Windows Certificate Store / Linux trust store) для проверки
# TLS Google. Задайте, только если на машине нет системного доверенного
# хранилища (например, минимальный контейнер без пакета ca-certificates) —
# тогда укажите путь к third_party/cacert.pem (абсолютный или относительно
# рабочей директории запуска).
# CA_BUNDLE_PATH=third_party/cacert.pem

# Куда писать логи — папка, внутри неё файл на каждый день
# ("<LOG_DIR>/2026-08-24-google-auth.log" и т.п. — имя сервиса в имени
# файла, чтобы не путать с логами других сервисов проекта; ротация — по
# смене даты, старые файлы не трогаются/не удаляются). По умолчанию (если
# не задано):
#   Windows — папка "logs" в рабочей директории (нет консоли у службы,
#             которую можно было бы смотреть);
#   Linux/Docker — stdout/stderr (так и должно быть в контейнере — логи
#             собирает раннтайм, а не сам процесс).
# Явные варианты:
#   LOG_DIR=var/log/google-auth — свой путь к папке (создастся сама)
#   LOG_DIR=stdout              — принудительно консоль даже на Windows
# LOG_DIR=

# true/1 — писать в лог ещё и значения параметров SQL-запросов ($1, $2, ...),
# не только сам текст запроса (см. README, "Логирование"). По умолчанию
# выключено: параметры — произвольные данные приложения (email и т.п.),
# включайте только для локальной отладки.
# LOG_SQL_PARAMS=true

# Доп. имена параметров (через запятую), чьи значения exec() маскирует "***"
# в логе при LOG_SQL_PARAMS=true — расширяет встроенный набор
# password/client_secret/refresh_token/access_token/id_token/token/secret
# (см. builtin_mask_param_names() в src/db.cpp), а не заменяет его.
# LOG_SQL_MASK_PARAMS=api_key,pin
